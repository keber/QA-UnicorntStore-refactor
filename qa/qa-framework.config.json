{
  "$schema": "./qa-framework.config.schema.json",
  "frameworkVersion": "1.10.0",
  "project": {
    "name": "QA-UnicorntStore-refactor",
    "displayName": "QA-UnicorntStore-refactor",
    "description": "Unicorn't Store: tienda geek de poleras/tazones con memes tech. Sitio front-end puro (sin login, sin backend/API), a validar con E2E antes de un refactor que cambiará la tecnología de base (referencia de arquitectura destino: https://neonpulse.keber.dev/, posiblemente con framework SPA encima).",
    "qaBaseUrl": "https://unicornt-store.keber.cl",
    "techStack": "Actual: HTML5 estático multi-página (index.html, product.html) + Bootstrap 5.3.8 + JavaScript vanilla (products.js/cart.js/app.js, sin build step, sin framework) + Font Awesome 6. Carrito persistido en localStorage (clave unicornt_cart). Sin backend/API. Confirmado vía exploración en vivo el 2026-08-26 (ver qa/memory/).",
    "loginPath": null
  },
  "modules": [
    {
      "code": "CAT",
      "name": "Catálogo",
      "submodules": [
        { "code": "LISTADO", "name": "Listado de productos", "route": "index.html#products" },
        { "code": "DETALLE", "name": "Detalle de producto", "route": "product.html?id={id}" }
      ]
    },
    {
      "code": "CARR",
      "name": "Carrito",
      "submodules": [
        { "code": "CARRITO", "name": "Carrito de compras (offcanvas)", "route": "presente en todas las paginas" }
      ]
    }
  ],
  "conventions": {
    "language": "es",
    "locale": "es-CL",
    "testCaseIdPattern": "TC-{MODULE}-{SUBMODULE}-{NUM}",
    "businessRuleIdPattern": "RN-{MODULE}-{NUM}",
    "workflowIdPattern": "FL-{MODULE}-{NUM}",
    "defectIdPattern": "DEF-{NUM}",
    "testNamingPattern": "[{ID}] {title} @{priority}",
    "timestampFormat": "YYYY-MM-DD_HH-MM-SS",
    "tcPriorityLevels": [
      "P0",
      "P1",
      "P2",
      "P3"
    ],
    "qaRoot": "qa"
  },
  "testUsers": [],
  "integrations": {
    "playwright": {
      "enabled": true,
      "automationRoot": "qa/07-automation/e2e",
      "workers": {
        "local": 2,
        "ci": 1
      },
      "timeout": 30000,
      "navigationTimeout": 60000,
      "actionTimeout": 10000,
      "retries": {
        "local": 0,
        "ci": 2
      },
      "browsers": [
        "chromium"
      ]
    },
    "azureDevOps": {
      "enabled": false
    },
    "githubActions": {
      "enabled": true,
      "workflowFile": ".github/workflows/qa-e2e.yml"
    }
  },
  "agentSettings": {
    "instructionsPath": "qa/00-guides",
    "credentialPolicy": "env-vars-only",
    "credentialPlaceholder": "<PLACEHOLDER>",
    "screenshotPath": "qa/07-automation/e2e/diagnosis",
    "sessionSummaryLocation": "qa/",
    "tc_per_submodule_target": {
      "min": 50,
      "max": 85
    }
  }
}
