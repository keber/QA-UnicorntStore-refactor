# -----------------------------------------------------------------------
# keber/qa-framework - Environment Variables Reference
# -----------------------------------------------------------------------
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
#
# The app now has a real backend (Spring Boot + JWT) — see
# qa/memory/arquitectura-unicornstore-2026-09-06.md. The suite targets the
# isolated QA stack so throwaway users and test orders never touch prod.
# Auth tests register a fresh user per run (no fixed QA_USER_* needed).
# -----------------------------------------------------------------------

# -----------------------------------------------------------------------
# Application Under Test — QA stack (isolated DB, Swagger open)
# -----------------------------------------------------------------------
QA_BASE_URL=https://unicornt-qa.keber.cl
QA_API_URL=https://api-unicornt-qa.keber.cl

# -----------------------------------------------------------------------
# CI / Pipeline overrides
# -----------------------------------------------------------------------
# CI=true           # Set automatically by GitHub Actions
